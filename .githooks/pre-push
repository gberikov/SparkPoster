#!/bin/sh
# Protects master and tags from deletion and history rewrites.
#
# The GitHub rulesets on master and refs/tags/** enforce the same rules server-side;
# this hook is the second line of defence and catches the mistake before the network
# round-trip. It is local: it works only where `git config core.hooksPath .githooks`
# has been run. Re-run that command after every clone — git does not carry config over.
#
# To bypass deliberately: git push --no-verify

zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/master|refs/tags/*) ;;
        *) continue ;;
    esac

    if [ "$local_sha" = "$zero" ]; then
        echo "pre-push: deleting $remote_ref is not allowed." >&2
        status=1
        continue
    fi

    if [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
        echo "pre-push: non-fast-forward push to $remote_ref is not allowed (history rewrite)." >&2
        status=1
    fi
done

exit $status
