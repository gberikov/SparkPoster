root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
end_of_line = crlf
indent_size = 4

[*.{csproj,props,targets,config,nuspec,slnx}]
end_of_line = crlf
indent_size = 2

[*.{json,yml,yaml,md}]
end_of_line = lf
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# Library code: a forgotten ConfigureAwait(false) must break our build rather than the
# consumer application. Tests do not need this rule and it only gets in the way there.
[src/**/*.cs]
dotnet_diagnostic.CA2007.severity = error

# A test name states what is being verified rather than naming an API for consumers:
# underscores make it more readable, not less.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
