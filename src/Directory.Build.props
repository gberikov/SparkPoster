<Project>

  <!-- Корневой Directory.Build.props MSBuild сам НЕ подхватит: он останавливается на
       первом найденном вверх по дереву. Поэтому импортируем явно. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Вместе с TreatWarningsAsErrors это значит: отсутствующий XML-док на публичном
         типе ломает сборку. Так и задумано — библиотеку собираемся публиковать. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>

    <Authors>Gany Berikov</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>sparkpost;email;transactional-email;webhooks</PackageTags>
  </PropertyGroup>

</Project>
