<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>IServiceCollection registration for SparkPoster on top of IHttpClientFactory.</Description>

    <!-- The generator ships transitively with Microsoft.Extensions.Options.ConfigurationExtensions
         and intercepts the Configure<SparkPostOptions>(configuration) call below, so binding needs
         no reflection. It has to be on here: interceptors rewrite call sites inside the compilation
         that runs the generator, and that call lives in this assembly, out of a consumer's reach. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SparkPoster\SparkPoster.csproj" />
  </ItemGroup>

</Project>
